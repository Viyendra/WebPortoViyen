{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "functions": {
    "api/test.php": {
      "runtime": "vercel-php@0.8.0"
    },
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "includeFiles": "../{app,bootstrap,config,database,public,resources,routes,storage,vendor}/**"
    }
  },
  "routes": [
    { "src": "/api/test", "dest": "/api/test.php" },
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "VERCEL": "1",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}
