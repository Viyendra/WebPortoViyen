{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "npm run build",
  "build": {
    "env": {
      "NOW_PHP_DEBUG": "1"
    }
  },
  "builds": [
    {
      "src": "api/*.php",
      "use": "vercel-php@0.9.0"
    }
  ],
  "routes": [
    { "src": "/api/test", "dest": "/api/test.php" },
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "VERCEL": "1",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}
